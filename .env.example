# Gere senhas fortes localmente; este arquivo nao contem credenciais.
MSSQL_SA_PASSWORD=

# Opcional: os tres campos precisam ser configurados juntos para criar o administrador inicial.
APP_ADMIN_EMAIL=
APP_ADMIN_PASSWORD=
APP_ADMIN_CPF=
APP_ADMIN_NAME=Administração Expansão

# Configure um servidor SMTP para habilitar o envio dos links de redefinição.
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@localhost
MAIL_AUTH=false
MAIL_STARTTLS_ENABLED=false
APP_PUBLIC_BASE_URL=http://localhost:8080
